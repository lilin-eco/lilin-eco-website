---
import '../styles/global.css';
import { company } from '../data/company';
interface Props { title?: string; description?: string; }
const {
  title = '礼林生态 · 工程项目软件解决方案',
  description = '达州礼林生态科技有限责任公司，提供工程项目信息管理、流程协同、资料管理与数据汇总相关的软件解决方案及实施服务。',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  ['/solutions/', '解决方案'], ['/cases/', '项目案例'], ['/services/', '实施服务'],
  ['/about/', '关于礼林'], ['/news/', '新闻动态'], ['/contact/', '联系我们'],
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="header" id="top">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="礼林生态首页">礼林生态<span>LILIN ECO</span></a>
        <nav class="desktop-nav" aria-label="主导航">
          {links.map(([href,label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="mobile-menu">
          <summary><span class="menu-label">菜单</span><span class="menu-icon" aria-hidden="true"></span></summary>
          <nav aria-label="移动导航"><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>首页</a>{links.map(([href,label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-top">
        <div><a class="footer-brand" href="/">礼林生态</a><p>{company.fullName}</p></div>
        <nav aria-label="页脚导航">{links.map(([href,label]) => <a href={href}>{label}</a>)}</nav>
        <a class="back-top" href="#top" aria-label="返回顶部">↑</a>
      </div>
      <div class="wrap footer-bottom"><span>© {new Date().getUTCFullYear()} {company.fullName} 版权所有</span><span>工程项目软件解决方案与实施服务</span></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('click', (event) => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
