---
import '../styles/global.css';
import { company } from '../data/company';
import { getImage } from 'astro:assets';
import brandLogo from '../assets/brand/logo-horizontal-green.png';
import brandShare from '../assets/brand/social-share.png';
import { createStructuredData, serializeJsonLd, sitePages } from '../lib/seo';
interface Props {
  title?: string; description?: string; noindex?: boolean;
  article?: { title: string; publishedTime: string; modifiedTime?: string; category: string };
}
const pageMetadata = sitePages[Astro.url.pathname];
const {
  title = pageMetadata?.title ?? sitePages['/'].title,
  description = pageMetadata?.description ?? company.description,
  noindex = false, article,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({ src: brandShare, width: 1200, height: 630, format: 'png' });
const imageUrl = new URL(socialImage.src, Astro.site).href;
const structuredData = createStructuredData({ site: Astro.site!, canonical, title, description, image: imageUrl, article });
const links = [
  ['/solutions/', '业务领域'], ['/cases/', '项目与实践'], ['/services/', '服务方式'],
  ['/about/', '关于礼林'], ['/news/', '新闻动态'], ['/contact/', '联系我们'],
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    {Astro.url.pathname === '/' && <meta name="baidu-site-verification" content="codeva-riOG52ahzO" />}
    <link rel="icon" href="/favicon.ico?v=lilin-green" sizes="48x48" />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/favicon-green.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="礼林生态" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="礼林生态品牌标志｜善心、善念、善行" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="礼林生态品牌标志｜善心、善念、善行" />
    {article && <><meta property="article:published_time" content={article.publishedTime} />{article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}<meta property="article:section" content={article.category} /></>}
    {!noindex && <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="header" id="top">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="礼林生态首页"><img src={brandLogo.src} width="512" height="208" alt="礼林生态 LILIN ECO" decoding="async" fetchpriority="high" /></a>
        <nav class="desktop-nav" aria-label="主导航">
          {links.map(([href,label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="mobile-menu">
          <summary><span class="menu-label">菜单</span><span class="menu-icon" aria-hidden="true"></span></summary>
          <nav aria-label="移动导航"><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>首页</a>{links.map(([href,label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-top">
        <div><a class="footer-brand" href="/" aria-label="礼林生态首页"><img src={brandLogo.src} width="512" height="208" alt="礼林生态 LILIN ECO" loading="lazy" decoding="async" /></a><p>{company.fullName}</p></div>
        <nav aria-label="页脚导航">{links.map(([href,label]) => <a href={href}>{label}</a>)}</nav>
        <a class="back-top" href="#top" aria-label="返回顶部">↑</a>
      </div>
      <div class="wrap footer-bottom"><span>© {new Date().getUTCFullYear()} {company.fullName} 版权所有</span><span>{company.positioning}</span></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('click', (event) => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
