---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews, formatDate } from '../../lib/news';
const news = await getPublishedNews();
---
<BaseLayout title="新闻动态 · 礼林生态">
<section class="page-heading"><div class="wrap"><p class="eyebrow">NEWS & UPDATES</p><h1>新闻动态</h1><p>公司消息、网站公告与工程项目软件服务动态。</p></div></section>
<section class="wrap content-section"><div class="list-label"><span>全部动态</span><span>{news.length} 篇文章</span></div>{news.map(post=><a class="news-row" href={`/news/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><div><span class="pill">{post.data.category}</span><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}{news.length === 0 && <p class="empty">暂无新闻，欢迎稍后关注。</p>}</section>
</BaseLayout>
