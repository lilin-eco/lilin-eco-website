---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CultureMark from '../../components/CultureMark.astro';
import { getPublishedNews, formatDate } from '../../lib/news';
export async function getStaticPaths() {
 return (await getPublishedNews()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title + '｜礼林生态'} description={post.data.description} article={{ title: post.data.title, publishedTime: post.data.pubDate.toISOString(), modifiedTime: post.data.updatedDate?.toISOString(), category: post.data.category }}>
  <article class="wrap article-section culture-section"><CultureMark word="善念" position="right" /><a class="text-link" href="/news/">← 返回新闻动态</a><header class="article-header"><span class="pill">{post.data.category}</span><h1>{post.data.title}</h1><p><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · 礼林生态</p></header><div class="prose"><Content /></div><div class="article-end"><span>感谢关注礼林生态</span><a class="text-link" href="/contact/">联系我们 <span aria-hidden="true">→</span></a></div></article>
</BaseLayout>
