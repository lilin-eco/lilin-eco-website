---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CultureMark from '../../components/CultureMark.astro';
import ContactInvite from '../../components/ContactInvite.astro';
import { solutionDetails, solutionPath } from '../../data/solution-details';

export function getStaticPaths() {
  return solutionDetails.map(solution => ({ params: { slug: solution.slug }, props: { solution } }));
}
const { solution } = Astro.props;
const related = solutionDetails.find(item => item.slug === solution.relatedSlug)!;
---
<BaseLayout>
  <section class="page-heading culture-section">
    <div class="wrap">
      <CultureMark word="善念" position="right" />
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/solutions/">业务领域</a><span aria-hidden="true">/</span><span aria-current="page">{solution.name}</span></nav>
      <p class="eyebrow">{solution.label}</p>
      <h1>{solution.name}</h1>
      <p class="page-description">{solution.summary}</p>
    </div>
  </section>
  <section class="wrap content-section detail-content">
    <div class="intro-spread"><h2>{solution.introTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2><p>{solution.intro}</p></div>
    <div class="topic-list">{solution.topics.map((topic, index) => <section class="topic-row"><div><span class="section-number">0{index + 1}</span><h2>{topic.title}</h2></div><p>{topic.text}</p></section>)}</div>
    <section class="intro-spread preparation"><h2>从现有工作，<br />开始沟通方案</h2><div><p>{solution.prepare}</p><a class="text-link" href="/contact/">沟通软件开发需求 <span aria-hidden="true">→</span></a></div></section>
    <section class="questions" aria-labelledby="questions-title"><h2 id="questions-title">您可能关心</h2>{solution.questions.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</section>
    <nav class="related" aria-label="相关应用方向"><span>相关应用方向</span><a class="text-link" href={solutionPath(related.slug)}>{related.name}<span aria-hidden="true">→</span></a><a class="text-link" href="/cases/">全部工程数字化应用<span aria-hidden="true">→</span></a></nav>
  </section>
  <ContactInvite />
</BaseLayout>

<style>
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; color: var(--muted); font-size: 11px; margin-bottom: 34px; }
  .breadcrumbs a:hover { color: var(--green); text-decoration: underline; }
  .page-heading { padding-top: 35px; }
  .page-description { max-width: 650px; }
  .topic-list { margin-top: 65px; }
  .topic-row { display: grid; grid-template-columns: 1fr 1.1fr; gap: 65px; padding: 38px 0; border-top: 1px solid var(--line); }
  .topic-row:last-child { border-bottom: 1px solid var(--line); }
  .topic-row > div { display: flex; align-items: baseline; gap: 26px; }
  .topic-row h2 { font-size: 26px; }
  .topic-row .section-number { margin-bottom: 0; }
  .topic-row p, .questions p { font-size: 14px; color: var(--muted); }
  .preparation { margin-top: 75px; }
  .preparation .text-link { margin-top: 20px; }
  .questions { margin-top: 75px; max-width: 850px; }
  .questions > h2 { font-size: 29px; margin-bottom: 26px; }
  .questions details { border-bottom: 1px solid var(--line); }
  .questions summary { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-block: 23px; cursor: pointer; list-style: none; }
  .questions summary::-webkit-details-marker { display: none; }
  .questions summary span { color: var(--green); font-size: 22px; }
  .questions details[open] summary span { transform: rotate(45deg); }
  .questions p { padding-bottom: 25px; max-width: 720px; }
  .related { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 36px; margin-top: 65px; padding-top: 30px; border-top: 1px solid var(--line); }
  .related > span { font-size: 12px; color: var(--muted); }
  @media (max-width: 700px) {
    .breadcrumbs { margin-bottom: 30px; font-size: 10px; gap: 7px; }
    .page-heading { padding-top: 22px; }
    .page-heading h1 { font-size: 30px; }
    .topic-list { margin-top: 40px; }
    .topic-row { grid-template-columns: 1fr; gap: 17px; padding-block: 28px; }
    .topic-row h2 { font-size: 23px; }
    .topic-row > div { gap: 18px; }
    .preparation, .questions { margin-top: 45px; }
    .questions > h2 { font-size: 26px; }
    .questions summary { font-size: 14px; padding-block: 20px; }
    .questions p, .topic-row p { font-size: 13px; }
    .related { margin-top: 45px; display: grid; gap: 10px; }
  }
</style>
