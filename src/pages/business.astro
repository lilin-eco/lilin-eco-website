---
import BaseLayout from '../layouts/BaseLayout.astro';
const sections = [
 ['01', '业务范围', '正式业务范围与服务方向整理完成后，将在此公布。'],
 ['02', '产品与服务', '具体产品、服务内容及合作方式，将随业务信息同步更新。'],
 ['03', '项目展示', '经确认可公开的项目资料与成果，将在此陆续呈现。'],
];
---
<BaseLayout title="业务展示 · 礼林生态">
<section class="page-heading wrap"><p class="eyebrow">BUSINESS & PROJECTS</p><h1>业务与项目</h1><p>了解礼林生态，关注每一步新的进展。</p></section>
<section class="wrap content-section"><div class="business-intro"><h2>让信息清晰，<br />让了解更进一步。</h2><p class="muted">业务资料正在整理中。我们将在本栏目集中展示正式确认的业务范围、产品服务与项目成果。</p></div><div class="business-list">{sections.map(([number,title,text])=><article class="business-row"><span class="section-number">{number}</span><div><h3>{title}</h3><p>{text}</p></div><span class="pill">待公布</span></article>)}</div><div class="callout"><div><h3>关注我们的最新消息</h3><p>业务与项目信息更新后，您也可以通过新闻动态了解进展。</p></div><a class="button" href="/news/">查看新闻动态 ↗</a></div></section>
</BaseLayout>
