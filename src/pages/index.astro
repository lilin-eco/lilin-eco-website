---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { company, solutions, serviceSteps } from '../data/company';
import { getPublishedNews, formatDate } from '../lib/news';
const news = (await getPublishedNews()).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>工程项目管理<br /><em>软件解决方案</em></h1>
        <p class="hero-description">连接项目台账、业务流程与文档资料，为工程项目的信息管理、协同处理和数据汇总提供软件建设方案。</p>
        <div class="hero-actions"><a class="button" href="/solutions/">了解解决方案 <span>→</span></a><a class="button button-outline" href="/contact/">项目咨询 <span>↗</span></a></div>
      </div>
      <ProjectVisual />
    </div>
  </section>
  <section class="wrap section">
    <div class="section-title"><div><p class="eyebrow">PRODUCTS & SOLUTIONS</p><h2>围绕实际业务问题，组织软件方案</h2><p>从信息分散、流转脱节与汇总繁琐等问题入手，建立项目、流程与资料之间的关联。</p></div><a class="text-link" href="/solutions/">全部解决方案 →</a></div>
    <div class="three-grid">{solutions.map(item => <a class="solution-card" href={`/solutions/#${item.id}`}><span class="card-number">{item.number}</span><div class="module-icon" aria-hidden="true"><span></span><span></span><span></span></div><h3>{item.title}</h3><p class="card-problem">{item.problem}</p><p>{item.description}</p><ul>{item.points.map(point => <li>{point}</li>)}</ul><span class="text-link">了解场景 <span>→</span></span></a>)}</div>
  </section>
  <section class="soft-section"><div class="wrap section">
    <div class="section-title"><div><p class="eyebrow">IMPLEMENTATION & SERVICES</p><h2>从业务梳理，到上线运行</h2><p>让需求、方案、开发与交付形成连续的实施过程。</p></div><a class="text-link" href="/services/">了解实施服务 →</a></div>
    <ol class="steps">{serviceSteps.map(([number,title,text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
  </div></section>
  <section class="about-band"><div class="wrap"><div><p class="eyebrow">ABOUT LILIN ECO</p><h2>礼林生态</h2><p class="company-name">{company.fullName}</p></div><div><p>礼林生态围绕工程项目中的信息管理、流程协同与数据汇总需求，开展软件方案设计、开发与实施服务。</p><a class="text-link" href="/about/">了解公司 →</a></div></div></section>
  <section class="wrap section">
    <div class="section-title"><div><p class="eyebrow">NEWS & UPDATES</p><h2>新闻动态</h2></div><a class="text-link" href="/news/">全部动态 →</a></div>
    {news.map(post => <a class="news-row" href={`/news/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><div><span class="pill">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="arrow" aria-hidden="true">→</span></a>)}
  </section>
  <section class="contact-banner"><div class="wrap"><div><h2>沟通您的工程项目软件需求</h2><p>从现有流程和实际问题出发，明确软件建设范围。</p></div><a class="button button-white" href="/contact/">联系我们 <span>→</span></a></div></section>
</BaseLayout>
