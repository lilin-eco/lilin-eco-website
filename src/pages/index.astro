---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { company, solutions, serviceSteps } from '../data/company';
import { getPublishedNews, formatDate } from '../lib/news';
const news = (await getPublishedNews()).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>工程项目软件 · 政府客户服务</p>
        <h1>以软件连接业务<br /><em>让工程管理更清晰</em></h1>
        <p class="hero-description">面向中国政府客户，围绕工程项目的信息管理与业务协同需求，提供软件项目服务。</p>
        <div class="hero-actions"><a class="button" href="/solutions/">了解解决方案 <span>→</span></a><a class="button button-outline" href="/contact/">项目咨询 <span>↗</span></a></div>
        <p class="hero-caption">达州礼林生态科技有限责任公司</p>
      </div>
      <ProjectVisual />
    </div>
  </section>
  <section class="focus-strip" aria-label="服务方向"><div class="wrap">
    <div><span>01</span><div><strong>面向政府客户</strong><small>围绕实际业务需求沟通</small></div></div>
    <div><span>02</span><div><strong>聚焦工程项目</strong><small>梳理项目、流程与信息关系</small></div></div>
    <div><span>03</span><div><strong>软件项目服务</strong><small>衔接需求、开发与实施工作</small></div></div>
  </div></section>
  <section class="wrap section">
    <div class="section-title"><div><p class="eyebrow">PRODUCTS & SOLUTIONS</p><h2>从工程场景出发，连接软件需求</h2><p>围绕项目信息、过程协同与数据展示，沟通适合业务的软件方案。</p></div><a class="text-link" href="/solutions/">全部解决方案 →</a></div>
    <div class="three-grid">{solutions.map(item => <a class="solution-card" href={`/solutions/#${item.id}`}><span class="card-number">{item.number}</span><div class="module-icon" aria-hidden="true"><span></span><span></span><span></span></div><h3>{item.title}</h3><p>{item.description}</p><ul>{item.points.map(point => <li>{point}</li>)}</ul><span class="text-link">了解场景 <span>→</span></span></a>)}</div>
  </section>
  <section class="soft-section"><div class="wrap section">
    <div class="section-title"><div><p class="eyebrow">IMPLEMENTATION & SERVICES</p><h2>从需求沟通，到实施交付</h2><p>按项目实际范围，梳理每一阶段的工作重点。</p></div><a class="text-link" href="/services/">了解实施服务 →</a></div>
    <ol class="steps">{serviceSteps.map(([number,title,text]) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
  </div></section>
  <section class="wrap section cases-home">
    <div class="section-title"><div><p class="eyebrow">PROJECT EXPERIENCE</p><h2>用真实项目，呈现服务价值</h2></div><a class="text-link" href="/cases/">项目案例 →</a></div>
    <div class="case-placeholder"><div class="case-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div><span class="pill">案例资料待公布</span><h3>项目经验，持续整理中</h3><p>经确认可公开的项目背景、软件建设内容与交付信息，将在案例栏目陆续展示。</p><a class="text-link" href="/cases/">了解案例展示内容 →</a></div></div>
  </section>
  <section class="about-band"><div class="wrap"><div><p class="eyebrow">ABOUT LILIN ECO</p><h2>礼林生态</h2><p class="company-name">{company.fullName}</p></div><div><p>我们面向中国政府客户，聚焦工程项目的软件需求与服务。通过清晰的业务沟通，让软件建设与实际管理场景建立联系。</p><a class="text-link" href="/about/">了解公司 →</a></div></div></section>
  <section class="wrap section">
    <div class="section-title"><div><p class="eyebrow">NEWS & UPDATES</p><h2>新闻动态</h2></div><a class="text-link" href="/news/">全部动态 →</a></div>
    {news.map(post => <a class="news-row" href={`/news/${post.id}/`}><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><div><span class="pill">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="arrow" aria-hidden="true">→</span></a>)}
  </section>
  <section class="contact-banner"><div class="wrap"><div><h2>从一次需求沟通，开启项目合作</h2><p>了解我们的联系信息，沟通工程项目的软件建设需求。</p></div><a class="button button-white" href="/contact/">联系我们 <span>→</span></a></div></section>
</BaseLayout>
