---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CultureMark from '../components/CultureMark.astro';
import NewsList from '../components/NewsList.astro';
import architecture from '../assets/architecture.png';
import worktable from '../assets/worktable.png';
import { businessAreas } from '../data/company';
import { getPublishedNews } from '../lib/news';
const news = (await getPublishedNews()).slice(0, 2);
---
<BaseLayout>
  <section class="home-hero culture-section">
    <div class="hero-media"><Image src={architecture} alt="树影落在浅色建筑外墙上" widths={[640, 960, 1536]} sizes="(max-width: 700px) 100vw, 68vw" format="webp" quality={85} loading="eager" fetchpriority="high" /></div>
    <div class="wrap hero-inner">
      <CultureMark word="善心" />
      <div class="hero-copy"><p class="hero-label">数字技术 · 工程服务 · 生态生活</p><h1>以技术与服务，<br />回应日常所需</h1><p class="hero-description">立足达州，连接数字技术、工程配套与生态服务，<br class="desktop-break" />也关照设备物资与日常生活中的具体需要。</p><a class="button" href="/solutions/">了解业务领域 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="home-solutions culture-section">
    <div class="wrap editorial-split">
      <CultureMark word="善念" />
      <div class="section-intro"><p class="eyebrow">OUR BUSINESS</p><h2>从日常需要出发</h2><span class="short-rule" aria-hidden="true"></span><a class="text-link" href="/solutions/">五个业务领域 <span aria-hidden="true">→</span></a></div>
      <div class="solution-links">{businessAreas.map(item => <a href={'/solutions/#' + item.id}><h3>{item.title}<span aria-hidden="true">→</span></h3><p>{item.homeDescription}</p></a>)}</div>
    </div>
  </section>
  <div class="worktable-banner"><Image src={worktable} alt="自然光下的图纸、铅笔与笔记本电脑，作为服务场景意象" widths={[640, 1280, 2172]} sizes="100vw" format="webp" quality={85} loading="lazy" /></div>
  <section class="home-services"><div class="wrap service-spread"><div><p>从一次沟通开始，把工作内容、服务范围和交付要求讲清楚，再按约定把每一步做好。</p><a class="text-link" href="/services/">了解服务方式 <span aria-hidden="true">→</span></a></div><h2>把需要听清楚，<br />把事情做踏实</h2></div></section>
  <section class="home-about culture-section">
    <div class="about-media"><Image src={architecture} alt="绿叶与建筑的光影细节" widths={[640, 960]} sizes="(max-width: 700px) 100vw, 55vw" format="webp" loading="lazy" /></div>
    <div class="wrap"><CultureMark word="善行" position="right" /><div class="about-copy"><p class="eyebrow">ABOUT LILIN</p><h2>心怀善意，<br />行于实处</h2><p>达州礼林生态科技有限责任公司，业务范围涉及软件与信息服务、工程与空间配套、生态技术、设备物资及运营生活服务。以“善心、善念、善行”为处事之道，认真回应每一份需要。</p><a class="text-link" href="/about/">关于礼林 <span aria-hidden="true">→</span></a></div></div>
  </section>
  <section class="home-news"><div class="wrap editorial-split"><div class="section-intro"><p class="eyebrow">NEWS & UPDATES</p><h2>新闻动态</h2><span class="short-rule" aria-hidden="true"></span><a class="text-link" href="/news/">全部动态 <span aria-hidden="true">→</span></a></div><NewsList posts={news} compact /></div></section>
  <section class="home-contact"><div class="wrap"><p>无论是项目建设，还是日常服务，都从认真沟通开始。</p><a class="button" href="/contact/">聊聊您的需要 <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
