---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CultureMark from '../components/CultureMark.astro';
import NewsList from '../components/NewsList.astro';
import architecture from '../assets/architecture.png';
import worktable from '../assets/worktable.png';
import { solutions, documentSolution } from '../data/company';
import { getPublishedNews } from '../lib/news';
const news = (await getPublishedNews()).slice(0, 2);
const featured = [solutions[0], solutions[1], documentSolution];
---
<BaseLayout>
  <section class="home-hero culture-section">
    <div class="hero-media"><Image src={architecture} alt="树影落在浅色建筑外墙上" widths={[640, 960, 1536]} sizes="(max-width: 700px) 100vw, 68vw" format="webp" quality={85} loading="eager" fetchpriority="high" /></div>
    <div class="wrap hero-inner">
      <CultureMark word="善心" />
      <div class="hero-copy"><p class="hero-label">工程项目软件解决方案</p><h1>让项目协作，<br />更从容</h1><p class="hero-description">连接项目信息、业务流程与工程资料，<br class="desktop-break" />让日常管理清晰有序。</p><a class="button" href="/solutions/">了解解决方案 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="home-solutions culture-section">
    <div class="wrap editorial-split">
      <CultureMark word="善念" />
      <div class="section-intro"><p class="eyebrow">SOLUTIONS</p><h2>从业务需要出发</h2><span class="short-rule" aria-hidden="true"></span><a class="text-link" href="/solutions/">全部解决方案 <span aria-hidden="true">→</span></a></div>
      <div class="solution-links">{featured.map(item => <a href={'/solutions/#' + item.id}><h3>{item.title}<span aria-hidden="true">→</span></h3><p>{item.homeDescription}</p></a>)}</div>
    </div>
  </section>
  <div class="worktable-banner"><Image src={worktable} alt="自然光下的工程图纸、铅笔与笔记本电脑" widths={[640, 1280, 2172]} sizes="100vw" format="webp" quality={85} loading="lazy" /></div>
  <section class="home-services"><div class="wrap service-spread"><div><p>面向工程项目，提供软件的定制开发与落地实施，帮助业务需求转化为稳定、好用的系统。</p><a class="text-link" href="/services/">了解实施服务 <span aria-hidden="true">→</span></a></div><h2>把需求，<br />落实为可用的软件</h2></div></section>
  <section class="home-about culture-section">
    <div class="about-media"><Image src={architecture} alt="绿叶与建筑的光影细节" widths={[640, 960]} sizes="(max-width: 700px) 100vw, 55vw" format="webp" loading="lazy" /></div>
    <div class="wrap"><CultureMark word="善行" position="right" /><div class="about-copy"><p class="eyebrow">ABOUT LILIN</p><h2>认真理解，<br />踏实交付</h2><p>礼林生态专注于工程项目领域的软件服务，提供工程项目软件解决方案、定制开发与实施支持。</p><a class="text-link" href="/about/">关于礼林 <span aria-hidden="true">→</span></a></div></div>
  </section>
  <section class="home-news"><div class="wrap editorial-split"><div class="section-intro"><p class="eyebrow">NEWS & UPDATES</p><h2>新闻动态</h2><span class="short-rule" aria-hidden="true"></span><a class="text-link" href="/news/">全部动态 <span aria-hidden="true">→</span></a></div><NewsList posts={news} compact /></div></section>
  <section class="home-contact"><div class="wrap"><p>从需求出发，让想法有序落地。</p><a class="button" href="/contact/">聊聊您的项目需求 <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
