---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import { allSolutions } from '../data/company';
---
<BaseLayout title="工程项目软件解决方案 · 礼林生态">
  <PageHeading label="SOLUTIONS" title="从业务需要出发" description="围绕项目信息、业务流程与工程资料，建立清晰、有序的软件管理方式。" word="善念" />
  <section class="wrap content-section">
    <div class="intro-spread"><h2>理解问题，<br />再组织方案</h2><p>不同项目的工作流程、参与角色和数据条件各有不同。我们从日常管理中的具体问题入手，梳理信息与业务之间的关系，结合实际需求确定软件功能与实施范围。</p></div>
    <nav class="anchor-nav" aria-label="方案目录">{allSolutions.map(item => <a href={'#' + item.id}><span>{item.number}</span>{item.title}</a>)}</nav>
    {allSolutions.map(item => <section class="solution-detail" id={item.id}>
      <div><span class="section-number">{item.number} / SOLUTION</span><h2>{item.title}</h2><p class="solution-context">{item.scene}</p></div>
      <div class="solution-body"><h3>{item.problem}</h3><p>{item.approach}</p><ul class="solution-points">{item.points.map(point => <li>{point}</li>)}</ul><h3>让日常管理更清晰</h3><p>{item.result}</p><a class="text-link" href="/contact/">沟通此方案 <span aria-hidden="true">→</span></a></div>
    </section>)}
  </section>
  <ContactInvite />
</BaseLayout>
