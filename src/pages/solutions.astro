---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import { businessAreas } from '../data/company';
import { solutionDetails, solutionPath } from '../data/solution-details';
---
<BaseLayout>
  <PageHeading label="OUR BUSINESS" title="让技术与服务，衔接具体需要" description="从软件与信息应用，到空间、环境、设备和日常服务，按实际需求确定每一项工作的内容。" word="善念" />
  <section class="wrap content-section">
    <div class="intro-spread"><h2>多一些理解，<br />再确定如何开始</h2><p>不同业务有不同的使用条件和工作方式。我们依据经营范围整理五个业务领域，先了解需要，再明确具体服务、合作边界与实施安排。</p></div>
    <nav class="anchor-nav" aria-label="业务领域目录">{businessAreas.map(item => <a href={'#' + item.id}><span>{item.number}</span>{item.title}</a>)}</nav>
    {businessAreas.map(item => <section class="solution-detail" id={item.id}>
      <div><span class="section-number">{item.number} / BUSINESS</span><h2>{item.title}</h2><p class="solution-context">{item.description}</p></div>
      <div class="solution-body"><h3>从具体场景出发</h3><p>{item.scene}</p><ul class="solution-points">{item.points.map(point => <li>{point}</li>)}</ul><h3>明确工作与交付</h3><p>{item.approach}</p><p>{item.result}</p>{item.id === 'digital-services' && <nav aria-label="工程数字化应用方向">{solutionDetails.map(solution => <div><a class="text-link" href={solutionPath(solution.slug)}>{solution.name} <span aria-hidden="true">→</span></a></div>)}</nav>}<a class="text-link" href="/contact/">沟通这类需求 <span aria-hidden="true">→</span></a></div>
    </section>)}
  </section>
  <ContactInvite />
</BaseLayout>
