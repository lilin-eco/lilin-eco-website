---
import BaseLayout from '../layouts/BaseLayout.astro';
import Landscape from '../components/Landscape.astro';
import { company } from '../data/company';
---
<BaseLayout title="公司介绍 · 礼林生态">
<section class="page-heading wrap"><p class="eyebrow">ABOUT LILIN ECO</p><h1>认识礼林生态</h1><p>从这里，了解我们的名字与新的开始。</p></section>
<section class="wrap split content-section"><Landscape compact /><div><span class="section-number">01 / 关于我们</span><h2>{company.fullName}</h2><p class="lead">欢迎来到礼林生态官方网站。</p><p class="muted">这里是公司的官方信息窗口。我们将通过这个窗口，持续向您介绍公司的业务、项目与最新动态，让信息更清晰，让沟通更便捷。</p><p class="notice">公司详细介绍正在整理中，更多信息将陆续公布。</p><a class="text-link" href="/news/">查看最新动态 <span>↗</span></a></div></section>
<section class="soft-section"><div class="wrap section"><div class="section-title"><div><p class="eyebrow">GET TO KNOW US</p><h2>每一次了解，都从真实开始</h2></div></div><div class="three-grid"><a class="info-card" href="/business/"><span class="section-number">01</span><h3>了解业务</h3><p>关注业务与项目的正式发布。</p><span class="text-link">业务展示 ↗</span></a><a class="info-card" href="/news/"><span class="section-number">02</span><h3>关注动态</h3><p>阅读公司公告与最新消息。</p><span class="text-link">新闻动态 ↗</span></a><a class="info-card" href="/contact/"><span class="section-number">03</span><h3>建立联系</h3><p>获取统一公布的对外联系信息。</p><span class="text-link">联系我们 ↗</span></a></div></div></section>
</BaseLayout>
