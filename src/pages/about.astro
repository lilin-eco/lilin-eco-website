---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import CultureMark from '../components/CultureMark.astro';
import ContactInvite from '../components/ContactInvite.astro';
import architecture from '../assets/architecture.png';
import { company } from '../data/company';
---
<BaseLayout title="关于礼林 · 礼林生态" description="礼林生态成立于2023年，立足四川达州，业务涵盖数字技术、工程服务、生态技术与生活服务，秉持善心、善念、善行的企业理念。">
  <PageHeading label="ABOUT LILIN" title="心怀善意，行于实处" description="把善心、善念、善行，融入每一次沟通与服务。" />
  <section class="wrap content-section">
    <div class="intro-spread about-intro">
      <div class="about-portrait"><Image src={architecture} alt="自然光影下的建筑细节" widths={[640, 960]} sizes="(max-width: 700px) 100vw, 42vw" format="webp" loading="lazy" /></div>
      <div class="about-text"><p class="eyebrow">公司简介</p><h2>{company.fullName}</h2><p>礼林生态成立于2023年，立足四川达州，业务涵盖软件开发与信息服务、工程与空间服务、生态与绿色技术、设备物资配套及运营生活服务。</p><p>我们坚持以实际需求为出发点，将技术应用与日常服务相结合，以认真负责的态度，做好每一项工作。</p><a class="text-link" href="/solutions/">了解业务领域 <span aria-hidden="true">→</span></a></div>
    </div>
    <section class="culture-story culture-section">
      <CultureMark word="善念" position="right" />
      <p class="eyebrow">企业理念</p><h2>善心、善念、善行</h2>
      <div class="culture-practices"><div><h3>善心</h3><p>以诚待人，尊重每一份信任。</p></div><div><h3>善念</h3><p>用心思考，让方案贴合实际。</p></div><div><h3>善行</h3><p>踏实做事，将承诺落实于行动。</p></div></div>
    </section>
  </section>
  <ContactInvite />
</BaseLayout>
