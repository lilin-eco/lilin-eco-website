---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import worktable from '../assets/worktable.png';
import { solutions, documentSolution } from '../data/company';
const directions = [solutions[0], solutions[1], documentSolution];
---
<BaseLayout title="项目案例 · 礼林生态">
  <PageHeading label="PROJECT EXPERIENCE" title="让方案，走进实际工作" description="关注具体业务场景中的软件建设与实施过程。" word="善行" />
  <section class="wrap content-section">
    <div class="case-intro"><div class="case-empty"><p class="eyebrow">项目案例</p><h2>公开案例正在整理中</h2><p>经确认可公开的项目内容，将在这里陆续更新。您可以先通过解决方案了解我们的服务方向与建设思路。</p><a class="text-link" href="/solutions/">查看解决方案 <span aria-hidden="true">→</span></a></div><div class="case-photo"><Image src={worktable} alt="工程资料与软件工作场景示意" widths={[640, 1280]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" loading="lazy" /></div></div>
    <div class="case-directions"><p class="eyebrow">相关服务方向</p><h2>从这些业务场景开始了解</h2><div class="solution-links">{directions.map(item => <a href={'/solutions/#' + item.id}><h3>{item.title}<span aria-hidden="true">→</span></h3><p>{item.homeDescription}</p></a>)}</div></div>
  </section>
  <ContactInvite />
</BaseLayout>
