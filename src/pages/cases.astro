---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import { applicationDirections } from '../data/company';
---
<BaseLayout title="项目与实践 · 礼林生态" description="围绕装饰工程项目管理与设计图纸资料管理，了解礼林生态关注的数字化应用场景与软件设计重点。">
  <PageHeading label="APPLICATION DIRECTIONS" title="以数字化思路，连接工程业务" description="围绕工程管理与图纸资料场景，关注流程协同、版本管理与信息追溯。" word="善行" />
  <section class="wrap content-section">
    <div class="intro-spread"><h2>从业务场景，<br />理解软件价值</h2><p>装饰工程涉及多角色协作、多阶段流转与持续积累的业务资料。我们从项目管理和图纸管理两个应用方向出发，梳理信息关联、流程衔接与权限边界。</p></div>
    <div class="application-directions">{applicationDirections.map((project,index) => <article class="application-direction"><div class="application-meta"><span class="section-number">0{index + 1} / APPLICATION</span><span class="project-category">{project.category}</span></div><h2>{project.title}</h2><p>{project.description}</p><ul class="solution-points">{project.focus.map(item => <li>{item}</li>)}</ul><p class="project-principle">{project.principle}</p></article>)}</div>
    <div class="intro-spread service-notes"><h2>让业务与系统，<br />形成有效衔接</h2><p>软件建设需要结合业务流程、组织分工与数据条件。围绕具体管理事项，沟通适合的功能范围、实施安排与服务方式。更多服务内容可查看<a class="inline-link" href="/solutions/">业务领域</a>。</p></div>
  </section>
  <ContactInvite />
</BaseLayout>
