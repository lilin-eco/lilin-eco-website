---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import { researchProjects } from '../data/company';
---
<BaseLayout title="项目与实践 · 礼林生态" description="了解礼林生态正在推进的装饰工程项目管理与设计图纸资料管理软件研发方向，项目状态按实际进展列示。">
  <PageHeading label="PROJECTS & PRACTICE" title="从实际问题，逐步走向实践" description="记录正在推进的研发方向，具体成果以实际完成与交付情况为准。" word="善行" />
  <section class="wrap content-section">
    <div class="intro-spread"><h2>软件研发，<br />从具体业务开始</h2><p>目前正在推进装饰工程项目管理与设计图纸资料管理两项软件研发。以下介绍关注的业务内容与当前阶段，不作为已交付产品或客户案例。</p></div>
    <div class="research-projects">{researchProjects.map((project,index) => <article class="research-project"><div class="research-meta"><span class="section-number">0{index + 1} / RESEARCH</span><span class="project-status">{project.status}</span></div><h2>{project.title}</h2><p>{project.description}</p><ul class="solution-points">{project.focus.map(item => <li>{item}</li>)}</ul><p class="project-progress">{project.progress}</p></article>)}</div>
    <div class="intro-spread service-notes"><h2>更多项目，<br />随实践逐步记录</h2><p>其他业务领域的项目资料，将在确认公开范围后更新。业务内容与合作方式，可先查看<a class="inline-link" href="/solutions/">业务领域</a>，或与我们直接沟通。</p></div>
  </section>
  <ContactInvite />
</BaseLayout>
