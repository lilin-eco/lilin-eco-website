---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ContactInvite from '../components/ContactInvite.astro';
import worktable from '../assets/worktable.png';
import { serviceSteps } from '../data/company';
---
<BaseLayout title="服务方式 · 礼林生态" description="从需求沟通、范围确认、方案安排到实施交付与维护跟进，了解礼林生态的服务方式。">
  <PageHeading label="HOW WE WORK" title="把需要听清楚，把事情做踏实" description="不同的服务内容，共同从清楚的沟通和约定开始。" word="善行" />
  <section class="wrap content-section">
    <div class="intro-spread service-intro"><h2>每一步，<br />都有清楚的安排</h2><p>软件开发、工程配套、技术服务与日常运营，有各自的工作方式。我们结合实际事项确认合作内容，让双方了解做什么、如何推进、怎样交付。</p></div>
    <ol class="service-table">{serviceSteps.map(([number,title,text]) => <li><span class="section-number">{number}</span><h2>{title}</h2><p>{text}</p></li>)}</ol>
    <div class="inner-photo"><Image src={worktable} alt="图纸与电脑组成的工作场景意象" widths={[640, 1280]} sizes="(max-width: 700px) 100vw, 1180px" format="webp" loading="lazy" /></div>
    <div class="intro-spread service-notes"><h2>把约定说清楚，<br />让合作有依据</h2><ul class="note-list"><li>确认实际场景、服务地点、工作条件与希望解决的问题。</li><li>明确服务内容、材料设备、双方分工及时间安排。</li><li>提前沟通验收、交接和后续维护要求。</li></ul></div>
  </section>
  <ContactInvite />
</BaseLayout>
